#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aliases {
		led0 = &phase1_led;
		led1 = &heimdall_led1;
		led2 = &heimdall_led2;
		led3 = &heimdall_led3;
	};

	leds {
		phase1_led: phase1_led {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "DWM3001CDK D9";
		};
		heimdall_led1: heimdall_led1 {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "DWM3001CDK D10";
		};
		heimdall_led2: heimdall_led2 {
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			label = "DWM3001CDK D11";
		};
		heimdall_led3: heimdall_led3 {
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			label = "DWM3001CDK D12";
		};
	};
};

/* J-Link OB VCOM wiring on the DWM3001CDK. */
&uart0_default {
	/delete-node/ group1;
	/delete-node/ group2;

	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 19)>;
	};

	group2 {
		psels = <NRF_PSEL(UART_RX, 0, 15)>;
		bias-pull-up;
	};
};

&uart0_sleep {
	/delete-node/ group1;
	/delete-node/ group2;

	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 19)>,
			<NRF_PSEL(UART_RX, 0, 15)>;
		low-power-enable;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/* Initial DW3110 bring-up: legacy SPI1 at 8 MHz, deliberately not SPIM3. */
&spi1_default {
	/delete-node/ group1;

	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
			<NRF_PSEL(SPIM_MISO, 0, 29)>,
			<NRF_PSEL(SPIM_MOSI, 0, 8)>;
	};
};

&spi1_sleep {
	/delete-node/ group1;

	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
			<NRF_PSEL(SPIM_MISO, 0, 29)>,
			<NRF_PSEL(SPIM_MOSI, 0, 8)>;
		low-power-enable;
	};
};

&spi1 {
	status = "okay";
	compatible = "nordic,nrf-spi";
	cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;

	dw3000: dw3000@0 {
		compatible = "decawave,dw3000";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;
		irq-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
		wakeup-gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
	};
};

/* The stock DK enables this Arduino-header bus; it is not wired on the CDK. */
&spi3 {
	status = "disabled";
};
