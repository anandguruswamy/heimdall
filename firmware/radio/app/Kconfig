mainmenu "UWB Phase 1 bring-up"

source "Kconfig.zephyr"
source "${ZEPHYR_BASE}/samples/subsys/usb/common/Kconfig.sample_usbd"

choice PHASE1_ROLE
	prompt "Phase 1 application role"
	default PHASE1_ROLE_DEV_ID

config PHASE1_ROLE_DEV_ID
	bool "DEV_ID probe"

config PHASE1_ROLE_TX
	bool "1000-frame IRQ-confirmed transmitter"

config PHASE1_ROLE_RX
	bool "Continuous IRQ-driven receiver"

config PHASE1_ROLE_SCHEDULED_TX
	bool "1000-frame radio-clock scheduled transmitter"


config PHASE1_ROLE_SENSING_RX
	bool "CIR/timestamp/CFO sensing receiver"

config PHASE1_ROLE_USB_THROUGHPUT
	bool "Finite radio-free USB CDC throughput benchmark"
	depends on USB_DEVICE_STACK_NEXT

config PHASE1_ROLE_TWR_INITIATOR
	bool "SS-TWR initiator"

config PHASE1_ROLE_TWR_RESPONDER
	bool "SS-TWR responder"

endchoice

config PHASE1_FRAME_COUNT
	int "Number of frames in finite Phase 1 runs"
	default 1000
	range 1 10000

config PHASE1_TX_PERIOD_MS
	int "Scheduled-TX frame period in milliseconds"
	default 20
	range 2 10000

config PHASE1_TX_FRAME_BYTES
	int "Scheduled-TX total frame bytes including FCS"
	default 1023
	range 12 1023
	depends on PHASE1_ROLE_SCHEDULED_TX
	help
		Total frame length used by the scheduled transmitter timing gate.
		The two hardware FCS bytes are included in this value.

config PHASE1_EXT_PHR
	bool "Use DW3000 extended PHR"
	default y
	help
		Select the extended PHR required for frames larger than 127 bytes.

config PHASE1_ENABLE_FRAME_FILTER
	bool "Enable 802.15.4 hardware frame filter"
	default n
	depends on PHASE1_ROLE_SCHEDULED_TX || PHASE1_ROLE_SENSING_RX
	help
		Enable PAN ID and data-frame filtering for the radio bring-up gate.

config PHASE1_FRAME_FILTER_EXTENDED
	bool "Allow extended frame types in hardware filter"
	default n
	depends on PHASE1_ENABLE_FRAME_FILTER
	help
		Add DWT_FF_EXTEND_EN to the hardware filter flags for the EXT-PHR
		combination test.

config PHASE1_NODE_ID
	int "Bring-up source node ID"
	default 0
	range 0 7
	depends on PHASE1_ROLE_SCHEDULED_TX || PHASE1_ROLE_SENSING_RX

config PHASE1_NETWORK_ID
	hex "Bring-up PAN ID"
	default 0xABCD
	range 0 65535
	depends on PHASE1_ROLE_SCHEDULED_TX || PHASE1_ROLE_SENSING_RX

config PHASE1_CONTINUOUS_TX
	bool "Run scheduled TX continuously"
	default n
	depends on PHASE1_ROLE_SCHEDULED_TX
	help
	  Keep transmitting scheduled frames until the board is reset or reflashed.

config PHASE1_CIR_DUMP
	bool "Dump complete CIR windows over UART"
	default n

config PHASE1_USB_TEST_RECORDS
	int "Number of synthetic USB records"
	default 1000
	range 1 100000
	depends on PHASE1_ROLE_USB_THROUGHPUT

config PHASE1_USB_TEST_PERIOD_US
	int "Delay between synthetic USB records in microseconds"
	default 20000
	range 1 1000000
	depends on PHASE1_ROLE_USB_THROUGHPUT

config PHASE1_USB_TEST_START_DELAY_MS
	int "Startup delay before synthetic USB records in milliseconds"
	default 5000
	range 0 30000
	depends on PHASE1_ROLE_USB_THROUGHPUT

config PHASE1_USB_BULK_TX
	bool "Use FIFO-filled interrupt-driven CDC transmission"
	default y
	depends on USB_DEVICE_STACK_NEXT

config PHASE1_CIR_TAPS
	int "Sensing CIR taps"
	default 64
	range 1 128
	depends on PHASE1_ROLE_SENSING_RX
	help
		Number of complex CIR taps read by the sensing receiver. Use 64 and
		128 for the callback timing gate.

config PHASE1_CIR_LEFT_TAPS
	int "Sensing CIR taps before first path"
	default 16
	range 0 127
	depends on PHASE1_ROLE_SENSING_RX
	help
		Number of CIR taps requested before the CIA first-path index.

config PHASE1_MEASURE_CALLBACK
	bool "Measure sensing RX callback duration"
	default n
	depends on PHASE1_ROLE_SENSING_RX
	help
		Toggle D9 around the sensing callback and report maximum callback,
		diagnostics-read, and CIR-read durations using the Zephyr cycle counter.

config PHASE1_MEASURE_REPORT_ASSEMBLY
	bool "Measure production beacon report assembly"
	default n
	depends on PHASE1_MEASURE_CALLBACK && HEIMDALL_BEACON
	help
		Encode the received CIR as a CRC-bearing beacon subreport, pack the
		rotated pooled report, build every balanced frame, and report separate
		subreport-encode and report-assembly maxima.

config HEIMDALL_BEACON
	bool "Heimdall superslot beacon protocol"
	default n
	help
	  Enable the Heimdall beacon protocol defined in
	  contracts/beacon-v1.md. Selecting this makes the build verify a
	  beacon configuration file and generate heimdall_beacon_config.h.
	  Point the build at a configuration with
	  -DHEIMDALL_CONFIG_FILE=<path>; it defaults to
	  deployment/beacon-config.example.json.

	  The configure stage fails if the configuration's declared derived
	  values disagree with the independently re-derived reference model in
	  tools/config/heimdall_config.py.

config HEIMDALL_NODE_ID
	int "Heimdall schedule node ID"
	default 0
	range 0 7
	depends on HEIMDALL_BEACON
	help
		Schedule position for this firmware image. The deployment roster must
		bind this position to the board hardware ID before transmission is
		enabled.
