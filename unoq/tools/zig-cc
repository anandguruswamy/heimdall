#!/bin/bash
set -euo pipefail

args=()
for arg in "$@"; do
    # cc-rs uses Rust triples; native Zig already targets this host and its
    # spelling is intentionally different.
    if [[ "$arg" != "--target=aarch64-unknown-linux-gnu" ]]; then
        args+=("$arg")
    fi
done
exec "${HEIMDALL_ZIG:-$HOME/.local/zig-aarch64-linux-0.15.2/zig}" cc "${args[@]}"
